# ============================================
# DeployDock - Environment Configuration
# ============================================
# Copy this file to .env and customize the values

# --- Database ---
POSTGRES_DB=deploydock
POSTGRES_USER=deploydock
POSTGRES_PASSWORD=deploydock_secret_password
DATABASE_URL=postgresql+asyncpg://deploydock:deploydock_secret_password@db:5432/deploydock

# --- Security ---
# Secret key for signing tokens and encrypting sensitive data
SECRET_KEY=change-me-to-a-random-64-char-string

# GitHub Webhook secret (must match the secret configured in GitHub)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here

# --- Docker ---
# Leave empty to use default Docker socket
# Linux: unix:///var/run/docker.sock
# Windows: npipe:////./pipe/docker_engine
# TCP: tcp://localhost:2375
DOCKER_HOST=

# --- Application ---
APP_NAME=DeployDock
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost"]

# Base path where cloned repositories will be stored
REPOS_BASE_PATH=/app/repos

# --- Health Checks ---
HEALTH_CHECK_TIMEOUT=30
HEALTH_CHECK_RETRIES=3
